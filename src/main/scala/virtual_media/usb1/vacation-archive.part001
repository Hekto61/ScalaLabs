  "manifestFile": "manifest.json"
}import MyJson.*

@main
def main(): Unit = {
  val configPath = os.pwd / "src" / "main" / "scala" / "config.json"
  val mediaRoot = os.pwd / "src" / "main" / "scala" / "virtual_media"

  val settings = loadOrCreateSettings(configPath)
  val catalogue = loadOrCreateCatalogue(mediaRoot)

  println(s"Настройки загружены. Доступно виртуальных носителей: ${catalogue.drives.size}")
  logEvent(settings, "Приложение запущено, конфигурация и носители загружены")
  println("Список виртуальных носителей:")
  catalogue.drives.foreach { drive =>
    val physFree = getPhysicalFreeSpace(mediaRoot, drive)
    val allowedFree = getAllowedFreeSpace(mediaRoot, drive, settings)
    println(s"- ${drive.mark} (папка: ${drive.path}): всего ${formatSize(drive.volume)}, свободно ${formatSize(physFree)}, доступно с учётом резерва ${formatSize(allowedFree)}")
  }

  var mySources: List[SourceItem] = List.empty

  mySources = SourceManager.addFile(mySources, configPath, settings)
  mySources = SourceManager.addDirectory(mySources, os.pwd / "src", settings)

  mySources = SourceManager.addFile(mySources, configPath, settings)

  SourceManager.printSummary("vacation-archive", mySources)
  val plan = Planner.buildPlan("vacation-archive", mySources, catalogue.drives, mediaRoot, settings)

  plan match {
    case Some(p) =>
      println("\nНачинаем запись...")
      val completedManifest = DataWriter.executeWrite(p, mediaRoot, settings)
    case None => ()
  }

  // Проверяем созданный набор по манифесту и восстанавливаем его в отдельную папку!
  val manifestPath = mediaRoot / catalogue.drives.head.path / settings.manifestFile
  if (os.exists(manifestPath)) {
    val savedManifest = read[ManifestData](os.read(manifestPath))

    // Проверка набора
    Restorer.verifySet(savedManifest, mediaRoot, settings)

    // Восстановление в папку "restored_test"
    val restoreDir = os.pwd / "restored_test"
    Restorer.restoreSet(savedManifest, restoreDir, mediaRoot, settings)
  }
  
}

import java.time.LocalDateTime
import java.util.UUID

object Planner {

  def buildPlan(
                 setName: String,
                 sources: List[SourceItem],
                 selectedDrives: List[Drive],
                 mediaRoot: os.Path,
                 settings: AppSettings
               ): Option[ManifestData] = {

    if (sources.isEmpty) {
      println("Ошибка: список исходных файлов пуст!")
      return None
    }
    if (selectedDrives.isEmpty) {
      println("Ошибка: не выбрано ни одного носителя!")
      return None
    }

    val filesOnly = sources.filter(!_.isDirectory)
    val totalDataSize = filesOnly.map(_.size).sum
    val serviceReserve = 64L * 1024 // под джисоны место

    val driveSpaces = selectedDrives.map { drive =>
      val usable = Math.max(0L, getAllowedFreeSpace(mediaRoot, drive, settings) - serviceReserve)
      if (usable < settings.minimumPartSize) {
        println(s"Предупреждение: носитель ${drive.mark} не вмещает даже минимальную часть (${formatSize(settings.minimumPartSize)})!")
      }
      (drive, usable)
    }

    val totalAvailable = driveSpaces.map(_._2).sum

    if (totalAvailable < totalDataSize) {
      val deficit = totalDataSize - totalAvailable
      println(s"\nНедостаточно места для создания набора.")
      println(s"Требуется: ${formatSize(totalDataSize)}")
      println(s"Доступно с учётом резерва: ${formatSize(totalAvailable)}")
      println(s"Не хватает: ${formatSize(deficit)}")
      println("Добавьте ещё один носитель или измените состав исходных данных.\n")
      logEvent(settings, s"Ошибка планирования набора $setName: не хватает ${formatSize(deficit)}")
      return None
    }

    var currentDriveIdx = 0
    var remainingOnDrive = driveSpaces(currentDriveIdx)._2
    var partNumber = 1
    var parts = List.empty[PartInfo]

    var fileIdx = 0
    var currentFileOffset = 0L

    while (fileIdx < filesOnly.size) {
      while (currentDriveIdx < driveSpaces.size && remainingOnDrive <= 0) {
        currentDriveIdx += 1
        if (currentDriveIdx < driveSpaces.size) {
          remainingOnDrive = driveSpaces(currentDriveIdx)._2
        }
      }

      val currentDrive = driveSpaces(currentDriveIdx)._1
      // Размер части ограничен и настройкой defaultPartSize, и свободным местом на текущей флешке
      val maxCurrentPartSize = Math.min(settings.defaultPartSize, remainingOnDrive)
      var currentPartSize = 0L
      var currentPartChunks = List.empty[FileChunkRef]

      // Наполняем текущую часть кусками файлов
      while (fileIdx < filesOnly.size && currentPartSize < maxCurrentPartSize) {
        val file = filesOnly(fileIdx)
        val fileRemaining = file.size - currentFileOffset

        if (fileRemaining == 0L) {
          fileIdx += 1
          currentFileOffset = 0L
        } else {
          val spaceInPart = maxCurrentPartSize - currentPartSize
          val takeBytes = Math.min(fileRemaining, spaceInPart)

          currentPartChunks = currentPartChunks :+ FileChunkRef(
            relativePath = file.relativePath,
            fileOffset = currentFileOffset,
            length = takeBytes
          )

          currentPartSize += takeBytes
          currentFileOffset += takeBytes

          if (currentFileOffset >= file.size) {
            fileIdx += 1
            currentFileOffset = 0L
          }
        }
      }

      if (currentPartChunks.nonEmpty) {
        val partFileName = formatPartName(settings.fileNameTemplate, setName, partNumber)
        parts = parts :+ PartInfo(
          number = partNumber,
          fileName = partFileName,
          mediaNumber = currentDriveIdx + 1,
          mediaMark = currentDrive.mark,
          mediaPath = currentDrive.path,
          size = currentPartSize,
          chunks = currentPartChunks
        )
        partNumber += 1
        remainingOnDrive -= currentPartSize
      }
    }

    val usedMediaCount = parts.map(_.mediaNumber).distinct.size
    val setId = UUID.randomUUID().toString.take(6)

    // Считаем контрольные суммы SHA-256 для всех исходных файлов
    val sourcesWithHashes = sources.map { s =>
      if (!s.isDirectory && s.readable) {
        s.copy(checksum = calculateFileChecksum(os.Path(s.originalPath), settings.checkSumAlgorithm))
      } else s
    }

    val manifest = ManifestData(
      setId = setId,
      name = setName,
      createdAt = LocalDateTime.now().toString,
      mediaCount = usedMediaCount,
      sources = sourcesWithHashes,
      parts = parts,
      mediaOrder = selectedDrives.take(usedMediaCount),
      checksumAlgorithm = settings.checkSumAlgorithm,
      preserveEmptyDirectories = settings.preserveEmptyDirectories,
      completed = false
    )

    printPlan(manifest, mediaRoot, settings)
    logEvent(settings, s"Построен план для набора $setName (ID: $setId): частей ${parts.size}, носителей $usedMediaCount")
    Some(manifest)
  }

  def printPlan(manifest: ManifestData, mediaRoot: os.Path, settings: AppSettings): Unit = {
    val totalSize = manifest.sources.filter(!_.isDirectory).map(_.size).sum
    println(s"\n=== План набора ${manifest.name} (ID: ${manifest.setId}) ===")
    println(s"Исходный объём: ${formatSize(totalSize)}")
    println(s"Носителей задействовано: ${manifest.mediaCount}")
    println(s"Частей: ${manifest.parts.size}\n")

    manifest.mediaOrder.zipWithIndex.foreach { case (drive, idx) =>
      val mediaNum = idx + 1
      val mediaParts = manifest.parts.filter(_.mediaNumber == mediaNum)
      val writtenBytes = mediaParts.map(_.size).sum
      val allowedFree = getAllowedFreeSpace(mediaRoot, drive, settings)
      val remaining = Math.max(0L, allowedFree - writtenBytes)
      val partRange = if (mediaParts.nonEmpty) s"${mediaParts.head.number}–${mediaParts.last.number}" else "нет"

      println(s"Носитель $mediaNum: ${drive.mark}")
      println(s"  Части: $partRange")
      println(s"  Будет записано: ${formatSize(writtenBytes)}")
      println(s"  Останется: ${formatSize(remaining)}\n")
    }
  }
}import MyJson.*
import java.io.RandomAccessFile
import scala.io.StdIn.readLine

object Restorer {
  // проверка набора (без восстановления)
  def verifySet(manifest: ManifestData, mediaRoot: os.Path, settings: AppSettings): Boolean = {
    println(s"\n=== Проверка набора ${manifest.name} (ID: ${manifest.setId}) ===")
    logEvent(settings, s"Начата проверка набора ${manifest.name} (ID: ${manifest.setId})")

    if (!manifest.completed) {
      println("Ошибка: набор не был завершён!")
      return false
    }

    var allOk = true

    for ((drive, idx) <- manifest.mediaOrder.zipWithIndex) {
      val mediaNum = idx + 1
      val driveFolder = mediaRoot / drive.path
      val expectedParts = manifest.parts.filter(_.mediaNumber == mediaNum)
      var mediaOk = true

      // Проверка media-info.json
      val descPath = driveFolder / settings.mediaDescriptorFile
      if (!os.exists(descPath)) {
        println(s"Носитель $mediaNum (${drive.mark}): ошибка (отсутствует ${settings.mediaDescriptorFile})")
        mediaOk = false
        allOk = false
      } else {
        try {
          val desc = read[MediaDescriptor](os.read(descPath))
          if (desc.setId != manifest.setId || desc.mediaNumber != mediaNum || !desc.completed) {
            println(s"Носитель $mediaNum (${drive.mark}): ошибка (неверный дескриптор или идентификатор!)")
            mediaOk = false
            allOk = false
          }
        } catch {
          case _: Exception =>
            println(s"Носитель $mediaNum (${drive.mark}): ошибка (повреждён ${settings.mediaDescriptorFile})")
            mediaOk = false
            allOk = false
        }
      }

      // Проверка по SHA-256
      for (part <- expectedParts) {
        val partPath = driveFolder / part.fileName
        if (!os.exists(partPath)) {
          println(s"Носитель $mediaNum: ошибка! Отсутствует часть ${part.fileName} (номер ${part.number})")
          mediaOk = false
          allOk = false
        } else {
          val actualSize = os.size(partPath)
          val actualHash = calculateFileChecksum(partPath, manifest.checksumAlgorithm)
          if (actualSize != part.size || actualHash != part.checksum) {
            println(s"Носитель $mediaNum: ошибка")
            println(s"  Повреждена часть: ${part.fileName} (номер ${part.number})")
            println(s"  Ожидаемый размер: ${part.size}, Фактический: $actualSize")
            println(s"  Ожидаемая сумма:  ${part.checksum}")
            println(s"  Фактическая сумма: $actualHash")
            mediaOk = false
            allOk = false
          }
        }
      }

      if (mediaOk) {
        println(s"Носитель $mediaNum (${drive.mark}): успешно")
      }
    }

    if (allOk) {
      println("\nВсе части успешно проверены! Набор полностью цел.")
      logEvent(settings, s"Проверка набора ${manifest.name} завершена успешно")
    } else {
      println("\nВосстановление полного набора невозможно.")
      logEvent(settings, s"Проверка набора ${manifest.name} выявила ошибки")
    }
    allOk
  }

  //Восстановление
  def restoreSet(
                  manifest: ManifestData,
                  targetDir: os.Path,
                  mediaRoot: os.Path,
                  settings: AppSettings
                ): Unit = {
    if (!manifest.completed) {
      println("Ошибка: набор не завершён! Восстановление невозможно.")
      return
    }

    val totalSize = manifest.sources.filter(!_.isDirectory).map(_.size).sum
    println(s"\n=== Сводка перед восстановлением ===")
    println(s"Набор: ${manifest.name}")
    println(s"Носителей: ${manifest.mediaCount}")
    println(s"Частей: ${manifest.parts.size}")
    println(s"Исходных объектов: ${manifest.sources.size}")
    println(s"Исходный объём: ${formatSize(totalSize)}")
    println(s"Каталог восстановления: $targetDir\n")

    // Проверка целостности
    if (!verifySet(manifest, mediaRoot, settings)) {
      println("Восстановление отменено из-за повреждения частей.")
      return
    }

    logEvent(settings, s"Начато восстановление набора ${manifest.name} в $targetDir")
    os.makeDir.all(targetDir)

    // Восстанавливаем пустые папки (если задано в настройках)
    if (manifest.preserveEmptyDirectories) {
      manifest.sources.filter(_.isDirectory).foreach { dir =>
        os.makeDir.all(targetDir / os.RelPath(dir.relativePath))
      }
    }

    var skippedFiles = Set.empty[String]
    var renameMap = Map.empty[String, os.Path]

    for (src <- manifest.sources.filter(!_.isDirectory)) {
      val outPath = targetDir / os.RelPath(src.relativePath)
      os.makeDir.all(outPath / os.up)

      if (os.exists(outPath)) {
        settings.overrideMode match {
          case "forbid" =>
            println(s"Файл уже существует (перезапись запрещена): $outPath. Пропускаем.")
            skippedFiles += src.relativePath
          case "overwrite" =>
            os.remove(outPath)
          case "rename" =>
            val renamed = outPath / os.up / s"restored_${outPath.last}"
            println(s"Файл существует, восстанавливаем как: $renamed")
            if (os.exists(renamed)) os.remove(renamed)
            renameMap += (src.relativePath -> renamed)
          case _ => // "ask"
            print(s"Файл $outPath уже существует. Перезаписать? (y/n): ")
            val ans = readLine().trim.toLowerCase
            if (ans == "y" || ans == "yes" || ans == "д") os.remove(outPath)
            else skippedFiles += src.relativePath
        }
      }
      if (src.size == 0L && !skippedFiles.contains(src.relativePath)) {
        val finalPath = renameMap.getOrElse(src.relativePath, outPath)
        os.write.over(finalPath, Array.emptyByteArray)
      }
    }

    // Части обратно в файлы
    for (part <- manifest.parts.sortBy(_.number)) {
      val driveFolder = mediaRoot / part.mediaPath
      val partPath = driveFolder / part.fileName
      val partBytes = os.read.bytes(partPath)
      var offsetInPart = 0

      for (chunk <- part.chunks) {
        if (!skippedFiles.contains(chunk.relativePath)) {
          val defaultOut = targetDir / os.RelPath(chunk.relativePath)
          val outPath = renameMap.getOrElse(chunk.relativePath, defaultOut)
          val chunkBytes = partBytes.slice(offsetInPart, offsetInPart + chunk.length.toInt)

          val raf = new RandomAccessFile(outPath.toIO, "rw")
          try {
            raf.seek(chunk.fileOffset)
            raf.write(chunkBytes)
          } finally {
            raf.close()
          }
        }
        offsetInPart += chunk.length.toInt
      }
    }

    // Проверка контрольных сумм восстановления
    var restoredCount = 0
    var verifiedCount = 0
    var corruptedCount = 0

    for (src <- manifest.sources.filter(!_.isDirectory)) {
      if (!skippedFiles.contains(src.relativePath)) {
        restoredCount += 1
        val outPath = renameMap.getOrElse(src.relativePath, targetDir / os.RelPath(src.relativePath))
        val actualHash = calculateFileChecksum(outPath, manifest.checksumAlgorithm)
        if (actualHash == src.checksum) {
          verifiedCount += 1
        } else {
          println(s"Ошибка контрольной суммы восстановленного файла: $outPath")
          corruptedCount += 1
        }
      }
    }

    val status = if (corruptedCount == 0) "УСПЕШНО" else "ЗАВЕРШЕНО С ОШИБКАМИ"
    println(s"\n================ ОТЧЁТ О ВОССТАНОВЛЕНИИ ================")
    println(s"Набор: ${manifest.name}")
    println(s"Каталог восстановления: $targetDir")
    println(s"Восстановлено файлов: $restoredCount")
    println(s"Проверено успешно: $verifiedCount")
    println(s"Повреждено или пропущено: ${corruptedCount + skippedFiles.size}")
    println(s"Итоговый статус: $status")
    println(s"========================================================\n")
    logEvent(settings, s"Восстановление завершено со статусом: $status")
  }
}import java.nio.file.Files

object SourceManager {
  def addFile(
               currentSources: List[SourceItem],
               filePath: os.Path,
               settings: AppSettings
             ): List[SourceItem] = {
    if (!os.exists(filePath) || os.isDir(filePath)) {
      println(s"Ошибка: файл не существует ($filePath)")
      logEvent(settings, s"Ошибка: попытка добавить несуществующий файл $filePath")
      currentSources
    } else {
      val relPath = filePath.last // имя файла
      if (currentSources.exists(_.relativePath == relPath)) {
        println(s"Ошибка! Конфликт путей: объект с относительным путём '$relPath' уже есть в наборе!")
        logEvent(settings, s"Конфликт относительных путей: $relPath")
        currentSources
      } else {
        val newItem = SourceItem(
          originalPath = filePath.toString,
          relativePath = relPath,
          size = os.size(filePath),
          lastModified = os.mtime(filePath),
          readable = Files.isReadable(filePath.toNIO)
        )
        println(s"Добавлен файл: $relPath (${formatSize(newItem.size)})")
        logEvent(settings, s"Добавлен файл в набор: $filePath")
        currentSources :+ newItem
      }
    }
  }


  def addDirectory(
                    currentSources: List[SourceItem],
                    dirPath: os.Path,
                    settings: AppSettings
                  ): List[SourceItem] = {
    if (!os.exists(dirPath) || !os.isDir(dirPath)) {
      println(s"Ошибка: каталог не существует ($dirPath)")
      logEvent(settings, s"Ошибка: попытка добавить несуществующий каталог $dirPath")
      currentSources
    } else {
      val parentDir = dirPath / os.up
      var updatedSources = currentSources
      var addedCount = 0

      os.walk(dirPath).foreach { path =>
        val relPath = path.relativeTo(parentDir).toString

        if (updatedSources.exists(_.relativePath == relPath)) {
          println(s"Пропущен из-за конфликта путей: $relPath")
        } else if (os.isDir(path)) {
          if (os.list(path).isEmpty && settings.preserveEmptyDirectories) {
            updatedSources = updatedSources :+ SourceItem(
              originalPath = path.toString,
              relativePath = relPath,
              size = 0L,
              lastModified = os.mtime(path),
              readable = true,
              isDirectory = true
            )
          }
        } else {
          updatedSources = updatedSources :+ SourceItem(
            originalPath = path.toString,
            relativePath = relPath,
            size = os.size(path),
            lastModified = os.mtime(path),
            readable = Files.isReadable(path.toNIO)
          )
          addedCount += 1
        }
      }

      println(s"Из каталога '${dirPath.last}' добавлено файлов: $addedCount")
      logEvent(settings, s"Добавлен каталог $dirPath (файлов: $addedCount)")
      updatedSources
    }
  }

  def printSummary(setName: String, sources: List[SourceItem]): Unit = {
    val files = sources.filter(!_.isDirectory)
    val dirs = sources.filter(_.isDirectory)
    val totalSize = files.map(_.size).sum
    val unreadableCount = sources.count(!_.readable)
    val conflictsCount = sources.groupBy(_.relativePath).count(_._2.size > 1)

    println(s"\n=== Сводка набора: $setName ===")
    println(s"Файлов: ${files.size}")
    println(s"Пустых каталогов: ${dirs.size}")
    println(s"Общий объём: ${formatSize(totalSize)}")
    println(s"Недоступно для чтения: $unreadableCount")
    println(s"Конфликтов путей: $conflictsCount\n")

    sources.foreach { item =>
      val info = if (item.isDirectory) "[Пустая папка]" else formatSize(item.size)
      println(s"  * ${item.relativePath} ($info)")
    }
  }
}import java.security.MessageDigest
import java.time.LocalDateTime
import java.time.format.DateTimeFormatter

def logEvent(settings: AppSettings, message: String): Unit = {
  val logPath = os.pwd / settings.logFile
  val timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss"))
  val logLine = s"[$timestamp] $message\n"

  os.write.append(logPath, logLine, createFolders = true)
}

def calculateChecksum(bytes: Array[Byte], algorithm: String = "SHA-256"): String = {
  val digest = MessageDigest.getInstance(algorithm)
  val hashBytes = digest.digest(bytes)
  hashBytes.map("%02X".format(_)).mkString
}


def calculateFileChecksum(path: os.Path, algorithm: String = "SHA-256"): String = {
  val bytes = os.read.bytes(path)
  calculateChecksum(bytes, algorithm)
}

def getUsedSpace(mediaRoot: os.Path, drive: Drive): Long = {
  val folderPath = mediaRoot / drive.path
  if (!os.exists(folderPath)) {
    0L
  } else {
     os.walk(folderPath)
     .filter(os.isFile)
     .map(os.size)
     .sum
    os.walk(folderPath).filter(os.isFile).map(os.size).sum
  }
}

def getPhysicalFreeSpace(mediaRoot: os.Path, drive: Drive): Long = {
  val used = getUsedSpace(mediaRoot, drive)
  Math.max(0L, drive.volume - used)
}

def getAllowedFreeSpace(mediaRoot: os.Path, drive: Drive, settings: AppSettings): Long = {
  val physicalFree = getPhysicalFreeSpace(mediaRoot, drive)
  Math.max(0L, physicalFree - settings.reservedSpacePerMedia)
}

def formatSize(bytes: Long): String = {
  if (bytes >= 1024L * 1024 * 1024) f"${bytes.toDouble / (1024 * 1024 * 1024)}%.2f ГБ"
  else if (bytes >= 1024L * 1024) f"${bytes.toDouble / (1024 * 1024)}%.2f МБ"
  else if (bytes >= 1024L) f"${bytes.toDouble / 1024}%.2f КБ"
  else s"$bytes Б"
}

def formatPartName(template: String, setName: String, number: Int): String = {
  val numStr = f"$number%03d"
  template.replace("{setName}", setName).replace("{number}", numStr)
}object MyJson extends upickle.AttributeTagged {
  override def serializeDefaults: Boolean = true
}
import MyJson.*

//import upickle.default.*
//import os.*

case class Drive (
                   id: Int,
                   mark: String = "BLUE-USB",
                   path: String,
                   volume: Long = 2L * 1024 * 1024 * 1024, //2 гигабайта
                   isProtected: Boolean = false
                 )derives ReadWriter

case class Catalogue(
                      drives: List[Drive]
                )derives ReadWriter


