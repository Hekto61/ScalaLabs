  "workDirectory": "transfer-work",
  "logFile": "transfer-manager.log",
  "defaultPartSize": 2147483648,
  "minimumPartSize": 67108864,
  "reservedSpacePerMedia": 524288000,
  "verifyAfterWrite": true,
